logoutput: stderr

internal: 0.0.0.0 port = {{ danted_listen_port | default(1080) }}
external: {{ danted_external_ip | default(ansible_default_ipv4.address) }}

user.privileged: root
user.unprivileged: nobody
user.libwrap: nobody

socksmethod: pam.username
clientmethod: none

client pass {
  from: 0.0.0.0/0 to: 0.0.0.0/0
  log: connect disconnect error
}

socks pass {
  from: 0.0.0.0/0 to: 0.0.0.0/0
  protocol: tcp udp
  log: connect disconnect error
}
